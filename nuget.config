<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Pomelo.EntityFrameworkCore.MySql 10.0.0 (upstream EF Core 10 build) is not
         on nuget.org yet (tracked by Pomelo issue #2007), while the floated EFData
         1.* dependency of the net10.0 asset requires it. Committed folder feed,
         same pattern as sufficit-identity.
         TEMPORARY: when Pomelo ships 10.x on nuget.org, remove this feed,
         the .nuget-feed folder and the mapping below. -->
    <add key="pomelo-10-feed" value="./.nuget-feed" />
  </packageSources>
  <!-- Both sources claim Pomelo by exact pattern (same specificity => NuGet searches both):
       older TFM assets (3.2.7 / 7.x) come from nuget.org, the 10.0.0 asset (not yet on
       nuget.org) from the committed feed. A lone wildcard on nuget.org would NOT be
       enough: the exact pattern below on the feed would outrank it and lock every TFM
       to the feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Pomelo.EntityFrameworkCore.MySql" />
    </packageSource>
    <packageSource key="pomelo-10-feed">
      <package pattern="Pomelo.EntityFrameworkCore.MySql" />
    </packageSource>
  </packageSourceMapping>
</configuration>
