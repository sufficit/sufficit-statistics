<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Sufficit's patched Pomelo builds for netstandard2.0 and net10.0. -->
    <add key="pomelo-feed" value="./.nuget-feed" />
  </packageSources>
  <!-- The exact mapping on both sources lets NuGet resolve upstream 7.x and the vendored builds. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Pomelo.EntityFrameworkCore.MySql" />
    </packageSource>
    <packageSource key="pomelo-feed">
      <package pattern="Pomelo.EntityFrameworkCore.MySql" />
    </packageSource>
  </packageSourceMapping>
</configuration>
